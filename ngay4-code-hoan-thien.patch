-function normalizePoi(raw) {
-  const poi = { ...raw };
-  const lat = Number(raw.latitude ?? raw.lat);
-  const lng = Number(raw.longitude ?? raw.lng);
-
-  if (Number.isFinite(lat) && Number.isFinite(lng) && lat >= -90 && lat <= 90 && lng >= -180 && lng <= 180) {
-    poi.lat = lat;
-    poi.lng = lng;
-  } else {
-    delete poi.lat;
-    delete poi.lng;
-  }
-  return poi;
-}
